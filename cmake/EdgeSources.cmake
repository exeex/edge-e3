include_guard(GLOBAL)

# Read the same -f/-F source manifests consumed by Verilator and synthesis.
# -f uses the caller's source root; -F rebases entries to that manifest's folder.
function(_edge_e3_collect_sources out_sources out_manifests manifest source_root stack)
  cmake_path(ABSOLUTE_PATH manifest NORMALIZE OUTPUT_VARIABLE manifest)
  if(manifest IN_LIST stack)
    message(FATAL_ERROR "Cyclic E3 source manifest: ${manifest}")
  endif()
  if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "Missing E3 source manifest: ${manifest}")
  endif()
  list(APPEND stack "${manifest}")
  set(sources)
  set(manifests "${manifest}")
  file(STRINGS "${manifest}" lines)
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "#.*$" "" line "${line}")
    string(STRIP "${line}" line)
    if(line MATCHES "^-([fF])[ ]+(.+)$")
      set(mode "${CMAKE_MATCH_1}")
      set(nested "${CMAKE_MATCH_2}")
      cmake_path(ABSOLUTE_PATH nested BASE_DIRECTORY "${source_root}" NORMALIZE)
      set(nested_root "${source_root}")
      if(mode STREQUAL "F")
        cmake_path(GET nested PARENT_PATH nested_root)
      endif()
      _edge_e3_collect_sources(nested_sources nested_manifests
        "${nested}" "${nested_root}" "${stack}")
      list(APPEND sources ${nested_sources})
      list(APPEND manifests ${nested_manifests})
    elseif(line MATCHES "\\.(v|sv)$")
      cmake_path(ABSOLUTE_PATH line BASE_DIRECTORY "${source_root}" NORMALIZE)
      if(NOT EXISTS "${line}")
        message(FATAL_ERROR "${manifest}: missing RTL ${line}")
      endif()
      list(APPEND sources "${line}")
    elseif(NOT line STREQUAL "" AND NOT line MATCHES "^\\+incdir\\+")
      message(FATAL_ERROR "${manifest}: unsupported source entry ${line}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES sources)
  list(REMOVE_DUPLICATES manifests)
  set(${out_sources} "${sources}" PARENT_SCOPE)
  set(${out_manifests} "${manifests}" PARENT_SCOPE)
endfunction()

function(edge_e3_read_sources out_sources manifest)
  cmake_path(GET manifest PARENT_PATH source_root)
  if(ARGC GREATER 2)
    set(source_root "${ARGV2}")
  endif()
  _edge_e3_collect_sources(sources manifests "${manifest}" "${source_root}" "")
  set(${out_sources} "${sources}" PARENT_SCOPE)
  set(${out_sources}_MANIFESTS "${manifests}" PARENT_SCOPE)
  if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${manifests})
    set_property(DIRECTORY APPEND PROPERTY EDGE_SOURCE_MANIFESTS ${manifests})
  endif()
endfunction()

function(edge_e3_product_sources out_sources component)
  set(e3_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  if(component STREQUAL "tensor")
    set(manifest "${e3_root}/edge_tensor_unit/filelists/edge_tensor.fl")
  elseif(component MATCHES "^(dtcm|accel)$")
    set(manifest "${e3_root}/edge_dtcm_subsys/filelists/edge_${component}.fl")
  else()
    message(FATAL_ERROR "Unknown E3 source component: ${component}")
  endif()
  edge_e3_read_sources(sources "${manifest}")
  set(${out_sources} "${sources}" PARENT_SCOPE)
  set(${out_sources}_MANIFESTS "${sources_MANIFESTS}" PARENT_SCOPE)
endfunction()
